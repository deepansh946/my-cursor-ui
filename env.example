# Vercel: direct FastAPI URL (required for SSE — do not proxy through Vercel)
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Local dev only — Next.js proxy to FastAPI
NEXT_API_BASE_URL=http://localhost:8000

# Auth.js + GitHub OAuth (callback: {AUTH_URL}/api/auth/callback/github)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=https://app.example.com
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
